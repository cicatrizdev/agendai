{
  "name": "autofix-agent-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "tsx scripts/verify.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "break": "tsx scripts/break.ts",
    "restore": "tsx scripts/restore.ts",
    "check:tasks": "tsx scripts/check-tasks.ts",
    "dev:api": "pnpm --filter @agendai/api dev",
    "dev:web": "pnpm --filter @agendai/web dev",
    "dev:console": "pnpm --filter @autofix/ops-console dev",
    "autofix": "pnpm --filter @autofix/agent autofix --"
  },
  "devDependencies": {
    "@agendai/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.135.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
