# Copie para .env e preencha. Nunca commite o .env.

# grok (padrão) | replay
# grok usa a CLI já logada. replay é para testes e quem grava sem CLI.
# AUTOFIX_PROVIDER=replay

# Supabase local: valores impressos por `supabase status`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Front-ends (Vite só expõe variáveis com prefixo VITE_)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# API do Agendaí
API_PORT=3333
