# Copie para .env e preencha. Nunca commite o .env.

# grok (padrão do agente, aula 2.1) | replay | anthropic | gemini
# grok usa a CLI já logada. Sem ferramenta de editar o repo. replay é o laboratório do módulo 1 e os testes.
# AUTOFIX_PROVIDER=replay

# Só se AUTOFIX_PROVIDER=anthropic. IDs de modelo ficam só aqui, nunca no código.
ANTHROPIC_API_KEY=
# Obrigatório se a chave não estiver ligada a um workspace. Console → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Só se AUTOFIX_PROVIDER=gemini
GEMINI_API_KEY=

AUTOFIX_MODEL_FAST=
AUTOFIX_MODEL_STRONG=

# local (padrão) | github
AUTOFIX_MODE=local

# Supabase local: valores impressos por `supabase status`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Chave de serviço usada APENAS pelo harness para escrever no schema "ops".
OPS_SUPABASE_SERVICE_KEY=

# Front-ends (Vite só expõe variáveis com prefixo VITE_)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# API do Agendaí
API_PORT=3333

# Modo github (Aula 6)
GITHUB_WEBHOOK_SECRET=
# Fine-grained, restrito ao repositório de exercícios
GITHUB_TOKEN=
